<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#101C30" />
            <corners android:radius="20dp" />
            <stroke android:width="4dp" android:color="#4EA8DE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_normal" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#2C2D35" />
        </shape>
    </item>
</selector>
